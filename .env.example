# Discord Bot Token
# https://discord.com/developers/applications で取得
DISCORD_BOT_TOKEN=xxxxx

# 管理者用DiscordチャンネルID（自己申告警告を受け取る）
ADMIN_CHANNEL_ID=1234567890123456789

# テスト通知の送信先チャンネルID（未設定の場合はコマンド実行チャンネル）
BOT_TEST_CHANNEL_ID=1234567890123456789

# Manager用DiscordユーザーID（/reply コマンドを使える人）
MANAGER_USER_ID=1234567890123456789

# Turso DB設定（省略可。省略時はローカルの bot_data.db を使用）
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
